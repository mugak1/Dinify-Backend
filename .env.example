# Django core
SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENV=dev

# OTP HMAC pepper (optional). If unset, it is derived deterministically from
# SECRET_KEY, so prod and CI work with no change. Set a dedicated value for
# stronger secret separation.
#OTP_HMAC_PEPPER=change-me-to-a-random-secret
#TEST_SMS_RECIPIENT=256700000000  # default --to for `manage.py send_test_sms` (gateway credential check)

# Diner-capability signing key. REQUIRED in a deployed environment (DEBUG=False):
# the application fails to start without it. It signs the anonymous diner QR
# credentials and table sessions and MUST differ from SECRET_KEY (at least 32
# chars of random material). Under DEBUG it may be left unset — a development-only
# key is then derived from SECRET_KEY with a visible warning. Rotating it
# invalidates every issued QR credential and diner session (diners simply
# rescan). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# PLACEMENT & PERMISSIONS (Apache/mod_wsgi deployments): this .env file is
# read at settings import by the Apache runtime user (www-data), so it must
# be group-readable by that user with NO group-write and NO 'other'
# permission bits — i.e. owner ubuntu:www-data with mode 640 (not 660/644/
# 642). A .env of mode 600 owned ubuntu:ubuntu
# passes every CLI check run as ubuntu and then kills the app at import with
# PermissionError under mod_wsgi (the 2026-07-17 UAT outage). Shell-profile
# exports (~/.bashrc, venv activate) are likewise CLI-only — mod_wsgi never
# sees them. Deployed runtime secrets belong in this project .env file and
# nowhere else: the deploy pipeline standardizes on it and validates it
# directly (as www-data, via RepositoryEnv('.env')).
#DINER_CAP_KEY=
# Diner table-session lifetime in seconds (optional; default 21600 = 6h).
#DINER_SESSION_TTL_SECONDS=21600

# Platform-admin secret encryption key (Fernet). Encrypts platform-staff TOTP
# secrets at rest for the admin control plane. NOT required for the inert
# identity layer (a PlatformStaffAuth row with no secret needs no key); it is
# read lazily and fails closed ONLY when an actual encrypt/decrypt runs (admin
# TOTP enrolment/verification, PR-2b). Must be a urlsafe-base64 Fernet key.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store it in this project .env (same placement & permission rules as
# DINER_CAP_KEY above), never in a shell profile.
#ADMIN_SECRET_ENCRYPTION_KEY=

# CORS — in development set CORS_ORIGIN_ALLOW_ALL=True
# In production, list origins explicitly in CORS_ALLOWED_ORIGINS
CORS_ORIGIN_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=

# JWT token lifetimes
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=1

# Database
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=dinify
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email
EMAIL_HOST=
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
EMAIL_PORT=587
